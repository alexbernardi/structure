# --- Local toolchain downloads (pinned in INFRASTRUCTURE/builds/toolchain.json) ---
/.tools/

# --- Mutable runtime data: dev world data, logs, test runs, pipeline scratch ---
/.runtime/

# --- World snapshots are local data, not source (see INFRASTRUCTURE/snapshots/README.md) ---
/INFRASTRUCTURE/snapshots/*
!/INFRASTRUCTURE/snapshots/README.md

# --- Godot caches (regenerated by `structure.py setup` / `--import`) ---
.godot/

# --- Generated build identity (written by the CLI before runs/builds; baked into images) ---
/SANDBOX/godot/build_manifest.json

# --- Utility config scratch (atomic-save temp/backup files next to committed JSON) ---
/utility/**/config/*.tmp
/utility/**/config/*.bak

# --- Python ---
__pycache__/
*.pyc
.venv/
.pytest_cache/

# --- Secrets / local overrides: never commit credentials ---
.env
*.local.env

# --- Blender autosaves ---
*.blend1
*.blend@

# --- OS / editor noise ---
.DS_Store
Thumbs.db
