## Writes the parameter and MIDI bank reference of the Movement Lab from the code, so the tables cannot drift from it:
##   AGENT-WORKSHOP/DOCUMENTATION/MOVEMENT-LAB-PARAMETERS.md
## Run:  godot --headless --path utility/movement/flat-plane --script res://tools/make_param_docs.gd
extends SceneTree

const Params = preload("res://movement/movement_params.gd")
const BodyParams = preload("res://animation/body_params.gd")
const GaitParams = preload("res://animation/gait_params.gd")
const RigParams = preload("res://animation/rig_params.gd")
const GraphParams = preload("res://animation/graph_params.gd")
const LocomotionParams = preload("res://animation/locomotion_params.gd")
const Bindings = preload("res://tuning/tuning_bindings.gd")

const OUT := "../../../AGENT-WORKSHOP/DOCUMENTATION/MOVEMENT-LAB-PARAMETERS.md"


func _num(v: Variant) -> String:
	var f := float(v)
	if is_equal_approx(f, round(f)):
		return str(int(round(f)))
	return ("%.4f" % f).rstrip("0").rstrip(".")


func _table(defs: Array, with_affects: bool) -> String:
	var s := "| id | label | unit | min | max | default | step | group |%s\n|---|---|---|---|---|---|---|---|%s\n" % [" affects |" if with_affects else "", "---|" if with_affects else ""]
	for d in defs:
		var kind := " (switch)" if d.get("type", "") == "bool" else ""
		s += "| `%s` | %s%s | %s | %s | %s | **%s** | %s | %s |%s\n" % [d.id, d.label, kind, d.unit, _num(d.min), _num(d.max), _num(d.default), _num(d.step), d.group, (" %s |" % d.get("affects", "physics")) if with_affects else ""]
	return s


func _banks(data: Dictionary) -> String:
	var s := ""
	for i in data.banks.size():
		var b: Dictionary = data.banks[i]
		s += "\n**Bank %d - %s**\n\n| strip | fader | knob |\n|---|---|---|\n" % [i + 1, b.name]
		for strip in range(1, 9):
			var slot: Dictionary = b.strips.get(str(strip), {})
			s += "| %d | %s | %s |\n" % [strip, ("`%s`" % slot.fader) if slot.has("fader") else "-", ("`%s`" % slot.knob) if slot.has("knob") else "-"]
	return s


func _initialize() -> void:
	var md := "# Movement Lab: parameter and MIDI reference\n\n"
	md += "Generated by `utility/movement/flat-plane/tools/make_param_docs.gd` from the code; do not edit by hand. Overview and architecture:\n"
	md += "[MOVEMENT-LAB-3.md](MOVEMENT-LAB-3.md); legacy details: [MOVEMENT-LAB-2.md](MOVEMENT-LAB-2.md). Units: metres, seconds, radians unless a unit column says otherwise (the gait and rig\n"
	md += "parameters use degrees and metres because they are easiest to judge on a controller). Defaults of the gait and proportion\n"
	md += "parameters are the values saved after the first tuning session (2026-11-07); `first_defaults` in `presets_gait/` keeps the ones before.\n\n"
	md += "## Movement (simulation, `movement.*`)\n\nThese change the physics.\n\n" + _table(Params.definitions(), false)
	md += "\n## Authored animation (`locomotion.*`)\n\nDefault Playground pipeline. Four principal sliders plus two switches; no physics writes.\n\n" + _table(LocomotionParams.definitions(), true)
	md += "\n## Legacy body dynamics (`body.*`)\n\nVisual only; inactive during authored playback: springs for the torso, pelvis, head, shoulders and arms.\n\n" + _table(BodyParams.definitions(), true)
	md += "\n## Legacy gait (`gait.*`)\n\nVisual only; inactive during authored playback. `walk_speed`, `view_*` and `edit_rig` only affect the treadmill lab.\n\n" + _table(GaitParams.definitions(), true)
	md += "\n## Proportions (`rig.*`)\n\nVisual only: limb lengths, joint offsets and thickness. A null rig means the original rig; these defaults are the tuned ones.\n\n" + _table(RigParams.definitions(), true)
	md += "\n## Legacy AnimationTree (`graph.*`)\n\nVisual only; inactive during authored playback: walk/fallback blend, additive body layer and normalized playback speed.\n\n" + _table(GraphParams.definitions(), true)
	md += "\n## MIDI banks: Playground (`config/locomotion_bindings.json`)\n\nFaders set a value with soft takeover; knobs fine-adjust the same value. Switches use a fader at or above half = on; a knob step toggles.\n" + _banks(Bindings.locomotion_data())
	md += "\n## Preserved legacy banks (`config/tuning_bindings.json`)\n\nSelectable with `--tuning-bindings=res://config/tuning_bindings.json`; old settings remain available but do not modify authored poses.\n" + _banks(Bindings.default_data())
	md += "\n## MIDI banks: treadmill gait lab (`config/gait_bindings.json`)\n" + _banks(Bindings.gait_data())
	var path := ProjectSettings.globalize_path("res://").path_join(OUT).simplify_path()
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		push_error("cannot write %s" % path)
		quit(1)
		return
	f.store_string(md)
	f.close()
	print("written: ", path, " (", md.length(), " chars)")
	quit(0)
