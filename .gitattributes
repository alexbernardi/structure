# Normalize text to LF (shell scripts run inside Linux containers).
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Small processed runtime assets: committed directly as binary.
*.glb binary
*.png binary
*.jpg binary
*.ogg binary

# Large editable source assets: Git LFS (see COMMON-ASSETS/README.md).
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
