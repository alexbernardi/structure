# Template for a server environment. Copy to <name>.env (file name == STRUCTURE_ENV_ID).
# No secrets belong here; these files are committed. Local-only overrides: <name>.local.env (git-ignored).
#
# Unique id: compose project "structure-<id>", container "structure-<id>-server",
# data directory .runtime/envs/<id>/data (world + runtime files, never shared).
STRUCTURE_ENV_ID=example
# Host UDP port (must be unique across environments; checked by `structure.py check`).
STRUCTURE_PORT=24599
# Host interface. Keep 127.0.0.1: development servers are not exposed beyond this machine.
STRUCTURE_BIND=127.0.0.1
# World identity and generation seed (an existing world keeps the seed it was created with).
STRUCTURE_WORLD_ID=example
STRUCTURE_WORLD_SEED=1337
STRUCTURE_MAX_PLAYERS=16
STRUCTURE_LOG_LEVEL=info
STRUCTURE_METRICS_INTERVAL=10
# Optional: pin a server build (structure-server:<tag>). Empty = newest local build.
STRUCTURE_IMAGE_TAG=
